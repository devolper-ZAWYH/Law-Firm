# ---------------------------------------------------------------------------
# AlBaker Law Firm — Authentication Portal
# Copy this file to `.env.local` for local development, and set the same
# variables in the Railway service dashboard for production.
# NEVER commit real values — .env* is git-ignored (except this example).
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key (server-side only — bypasses RLS).
# Found in: Supabase Dashboard > Project Settings > API > service_role.
# This key must NEVER be exposed to the browser. It is only read in server code.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string. REQUIRED in the deployment environment.
#
# The running app never reads it — that talks to Supabase over REST with
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY. It is what `npm run migrate` uses,
# and on Vercel the migration runs during the BUILD (see the `vercel-build`
# script), because Vercel has no start command to hang it on. Without this set
# in the Build environment, every deploy skips the migration with a loud
# MIGRATION PROBLEM warning and the schema silently stops moving. Format:
# postgresql://postgres:[PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Secret used to sign the session JWT (HS256). Generate a strong random value:
#   openssl rand -base64 48
# Must be at least 32 characters. Keep it identical across all app instances.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# GOOGLE DRIVE (optional) — powers the folder Documents tab.
#
# Without these two the tab still works: it reports that the Drive connection
# is not set up, and the Drive icon in the folder header keeps working. With
# them, the tab lists the contents of each folder's linked Drive folder.
#
# SETUP
#   1. Google Cloud console → create a project (or reuse one).
#   2. Enable the "Google Drive API" for it.
#   3. Create a SERVICE ACCOUNT; create a JSON key for it.
#   4. Put the JSON's `client_email` in GOOGLE_SERVICE_ACCOUNT_EMAIL.
#   5. Put the JSON's `private_key` in GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY,
#      exactly as it appears including the BEGIN/END lines. Literal \n
#      sequences are handled, so pasting the raw JSON value works.
#   6. In Drive, SHARE each matter folder (or one parent folder that contains
#      them) with the service account's email address, as Viewer. A folder that
#      is not shared reports "not shared with the portal's service account"
#      rather than appearing empty.
#
# Read-only access is requested; the portal never modifies anything in Drive.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
